# ==============================================================================
# SYNAPSE QUIZ - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# ─── BANCO DE DADOS (DESENVOLVIMENTO LOCAL VS. PRODUÇÃO TURSO) ──────────────────
# No desenvolvimento local, utiliza SQLite simples:
DATABASE_URL="file:./dev.db"

# Em produção na Vercel com Turso (libSQL):
# 1. Crie o banco: turso db create synapse-quiz
# 2. Obtenha a URL: turso db show synapse-quiz --url
# 3. Gere o token: turso db tokens create synapse-quiz
TURSO_DATABASE_URL="libsql://synapse-quiz-seu-usuario.turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOiJFZERTQ..."

# ─── AUTENTICAÇÃO E SEGURANÇA (JWT) ───────────────────────────────────────────
# Chave secreta usada para assinar cookies e tokens de sessão.
# Em produção, gere uma chave forte (ex: openssl rand -base64 32):
JWT_SECRET="sua-chave-secreta-jwt-super-segura-troque-em-producao"

# ─── E-MAIL (verificação de cadastro e recuperação de senha) ───────────────────
# Envio via SMTP. Para começar de graça: crie uma conta Gmail dedicada ao site,
# ative a verificação em duas etapas e gere uma "senha de app" em
# https://myaccount.google.com/apppasswords (NÃO use a senha normal da conta).
# Sem SMTP_USER/SMTP_PASS, em desenvolvimento o e-mail é apenas impresso no console.
# Com domínio próprio no futuro, basta trocar SMTP_HOST/USER/PASS/EMAIL_FROM.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="conta-do-site@gmail.com"
# SMTP_PASS="senha-de-app-de-16-letras"
# EMAIL_FROM="Synapse Quiz <conta-do-site@gmail.com>"
# E-mails dos administradores (separados por vírgula): acesso à tela /admin/reports.
# Precisam ser contas cadastradas no site, com e-mail verificado. Sem isso, ninguém acessa.
# ADMIN_EMAILS="voce@exemplo.com"
# Para onde vai o aviso de cada report de questão (padrão: o próprio SMTP_USER):
# REPORTS_NOTIFY_EMAIL="suporte@exemplo.com"
# URL pública usada nos links dos e-mails (obrigatória em produção):
# NEXT_PUBLIC_APP_URL="https://synapsequiz.vercel.app"

# ─── MONETIZAÇÃO E ASSINATURAS (STRIPE) ────────────────────────────────────────
# Obtenha as chaves em: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
#
# ID do preço do Plano Pro configurado no Stripe:
# STRIPE_PRICE_ID_PRO="price_..."
#
# URL da aplicação em produção:
# NEXT_PUBLIC_APP_URL="https://synapsequiz.com"

# ─── CONTAS DE DEMONSTRAÇÃO (seed) ────────────────────────────────────────────
# Se não definir as senhas, o seed gera uma senha aleatória e a imprime no console.
# SEED_DEMO_PASSWORD="troque-por-uma-senha"
# Conta Pro opcional: só é criada se SEED_PRO_EMAIL estiver definido
# SEED_PRO_EMAIL="pro@exemplo.com"
# SEED_PRO_PASSWORD="troque-por-uma-senha"
