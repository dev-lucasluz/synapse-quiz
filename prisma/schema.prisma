datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Planos disponíveis ───────────────────────────────────────────────────────
// free  → 10 questões/dia base (+ bônus referral até 20)
// pro   → questões ilimitadas, sem ads, filtros avançados, estatísticas
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  referralCode String  @unique
  referredById String?

  // Plano atual: "free" | "pro"
  // Atualizado pelo webhook do Stripe ao confirmar pagamento
  plan         String  @default("free")

  // Perfil acadêmico e foto do estudante
  avatarUrl       String?
  college         String?
  period          String?
  targetSpecialty String?

  // IDs do Stripe — preenchidos na integração de pagamento
  // null enquanto usuário nunca tentou assinar
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  referredBy User?  @relation("UserReferrals", fields: [referredById], references: [id])
  referrals  User[] @relation("UserReferrals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Preenchido quando o usuário confirma o e-mail. Só indicações verificadas rendem bônus de cota.
  emailVerifiedAt DateTime?

  streakCount    Int      @default(0)
  lastActiveDate String?

  reviews      UserCardReview[]
  dailyUsage   DailyUsage[]
  bookmarks    Bookmark[]
  subscription Subscription?
  notes        QuestionNote[]
  reports      QuestionReport[]
  answerLogs   AnswerLog[]
  simulations  Simulation[]
  emailTokens  EmailToken[]
}

// Tokens de uso único enviados por e-mail (verificação e redefinição de senha).
// Só o hash SHA-256 fica no banco; o token em si vai apenas no link do e-mail.
model EmailToken {
  id        String    @id @default(uuid())
  userId    String
  // "verify_email" | "reset_password"
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

// ─── Subscription ─────────────────────────────────────────────────────────────
// Registro de assinatura ativa. Criado/atualizado via webhook Stripe.
// Permite histórico e gestão de cancelamentos.
// ─────────────────────────────────────────────────────────────────────────────
model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])

  // Dados do Stripe
  stripeSubscriptionId String   @unique
  stripePriceId        String   // ID do preço/produto no Stripe
  stripeCurrentPeriodEnd DateTime // Data de expiração do período atual

  // Status: "active" | "canceled" | "past_due" | "trialing" | "incomplete"
  status               String   @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id        String     @id @default(uuid())
  name      String
  period    Int
  category  String
  questions Question[]
}

model Question {
  id            String  @id @default(uuid())
  subjectId     String
  subtopic      String? // Subtópico temático específico da questão
  text          String
  imageUrl      String?
  options       String  // JSON: ["texto A", "texto B", "texto C", "texto D"]
  correctOption Int
  explanation   String
  source        String
  year          Int

  // Nível de acesso: "free" | "pro"
  // Questões "pro" ficam bloqueadas para usuários free
  accessLevel   String  @default("free")

  // Status de ativação da questão no sistema (permite inativar para atualizações futuras)
  isActive      Boolean @default(true)

  subject    Subject          @relation(fields: [subjectId], references: [id])
  reviews    UserCardReview[]
  bookmarks  Bookmark[]
  notes      QuestionNote[]
  reports    QuestionReport[]
  answerLogs AnswerLog[]
}

model UserCardReview {
  id              String   @id @default(uuid())
  userId          String
  questionId      String
  repetitionCount Int      @default(0)
  easeFactor      Float    @default(2.5)
  intervalDays    Int      @default(0)
  dueDate         DateTime @default(now())
  lastReviewedAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
}

model DailyUsage {
  id                    String @id @default(uuid())
  userId                String
  date                  String // YYYY-MM-DD
  mainCardsReviewed     Int    @default(0)
  notebookCardsReviewed Int    @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model QuestionNote {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model QuestionReport {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  reason     String   // "gabarito_errado" | "desatualizado" | "erro_digitacao" | "outro"
  comment    String?
  status     String   @default("pending") // "pending" | "resolved"
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AnswerLog {
  id               String   @id @default(uuid())
  userId           String
  questionId       String
  selectedOption   Int
  isCorrect        Boolean
  mode             String   // "daily" | "notebook" | "simulation"
  timeSpentSeconds Int?
  createdAt        DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Simulation {
  id              String   @id @default(uuid())
  userId          String
  title           String
  subjectName     String?
  totalQuestions  Int
  correctCount    Int
  durationSeconds Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

